{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|LS|WebFetch|WebSearch|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "[ -z \"$MOTHER_CHANNEL_ROLE\" ] || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/mother\" sync --quiet",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/mother\" sync --quiet",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
