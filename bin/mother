# ---------------------------------------------------------------- main

COMMANDS = {"init": cmd_init, "join": cmd_join, "sync": cmd_sync, "scan": cmd_scan, "home": cmd_home,
            "status": cmd_status, "register": cmd_register, "runs": cmd_runs, "link": cmd_link, "channels": cmd_channels, "whatsapp": cmd_whatsapp, "items": cmd_items, "now": cmd_now, "hub": cmd_hub, "grant": cmd_grant, "memory": cmd_memory, "eval": cmd_eval, "health": cmd_health, "speak": cmd_speak, "tts": cmd_tts,
            "path": lambda a: print(workspace()), "version": lambda a: print(VERSION)}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd = COMMANDS.get(argv[0])
    if not cmd:
        die(f"unknown command '{argv[0]}' — see `mother help`")
    if argv[0] == "sync":
        try:
            cmd(argv[1:])
        except Exception as e:  # the sync hook must never fail a turn
            print(f"mother sync: unexpected error: {e}", file=sys.stderr)
        sys.exit(0)
    cmd(argv[1:])


if __name__ == "__main__":
    main(sys.argv[1:])
