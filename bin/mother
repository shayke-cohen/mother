#!/usr/bin/env python3
"""mother — workspace CLI for the MOTHER plugin.

Commands:
  init <path> [--remote URL]   create a workspace (layout, git, pointer)
  join <git-url> [path]        clone an existing workspace on another machine
  sync [--quiet]               scan, commit, rebase, push (always exits 0; used by hooks)
  scan [files...]              secret-scan files (default: changed files in the workspace); exit 1 on a hit
  home show|set [host]|check|move <host>
                               which machine runs routines (check: 0 = here, 2 = elsewhere, 3 = unset)
  status                       validate config.json and show workspace state; exit 1 if invalid
  register                     print the scheduled-task pointers for enabled routines (JSON)
  runs [--json]                watchdog: did each scheduled routine log a run since its last slot? exit 2 if any missed/failed
  path                         print the active workspace path
  link [dir]                   put `mother` on your PATH: symlink into dir (default ~/.local/bin)
  channels <cmd>               reply modes for team channels (`mother channels help`)
  whatsapp <cmd>               read WhatsApp chats from the local database (chats, read) and send through the
                               bridge (send; the guard asks first), install/stop/status (`mother whatsapp help`); home machine only
  whatsapp setup | link | unlink
                               the manager's guided WhatsApp setup and device link; own terminal only (a TTY; the guard denies them to the agent)
  hub watch|install|uninstall|check|smoke|status|tail|decide|session|pending|done|snooze|show
                               the hub's watcher and its launchd job (`mother hub help`; docs/CONTRACT.md §5e)
  hub add|follow|unfollow|mute|unmute|watching
                               the manager's steering: hand the hub a link or note, and the watch and mute lists
  grant add <scope> <target> --by <user-id> --cites <link|ts> [--uses N] [--hours H] [--run ID] | remove --run ID | list
                               the only writer of .mother/grants.json for unattended runs (checked like the guard)
  memory index <memory-file> [--title T] [--hook H] | check
                               add one `- [Title](file.md) — hook` line to memory/MEMORY.md (idempotent); check
                               lists unindexed memory files and index lines pointing at missing ones (JSON)
  items check [--file F] [--max N]
                               evidence check on a reader sub-agent's reply: drop uncited items; exit 2 = unusable
  now merge|show|done|snooze|top|do
                               the Now list behind the hourly tick and panel (`mother now help`); merge reads JSON on stdin
  eval brief|verdict|report    A/B the brief's gather mode on the same inputs (`mother eval help`)
  health record|pick|classify|summary|merge|alert|pending  per-server connector health in capabilities.json (`mother health help`)
  speak [--in FILE] [--name N] [--voice V] [--rate WPM]
                               render a spoken script (stdin or FILE) to <workspace>/.mother/audio/<name>.m4a
  tts setup [--from DIR] | tts status
                               install the Kokoro neural voice into ~/.mother/tts (optional; English only)

The workspace is resolved from $MOTHER_WORKSPACE, else <state>/workspace, where <state> is
$MOTHER_STATE_DIR or ~/.mother. Python 3.9 stdlib only (see docs/CONTRACT.md).
"""
import datetime as _dt
import json
import os
import re
import shutil
import socket
import subprocess
import sys
from pathlib import Path

VERSION = "0.9.1"
PLUGIN_ROOT = Path(__file__).resolve().parent.parent
TEMPLATE = PLUGIN_ROOT / "templates" / "workspace"

# ---------------------------------------------------------------- paths

def state_dir() -> Path:
    return Path(os.environ.get("MOTHER_STATE_DIR") or Path.home() / ".mother")


def workspace(required: bool = True):
    env = os.environ.get("MOTHER_WORKSPACE")
    if env:
        return Path(env).expanduser()
    ptr = state_dir() / "workspace"
    if ptr.is_file():
        p = ptr.read_text().strip()
        if p:
            return Path(p).expanduser()
    if required:
        die("no workspace configured — run `mother init <path>` or `mother join <git-url>`")
    return None


def set_pointer(ws: Path) -> None:
    sd = state_dir()
    sd.mkdir(parents=True, exist_ok=True)
    (sd / "workspace").write_text(str(ws.resolve()) + "\n")


def die(msg: str, code: int = 1):
    print(f"mother: {msg}", file=sys.stderr)
    sys.exit(code)


def now_iso() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def git(ws: Path, *args, check=False):
    return subprocess.run(["git", "-C", str(ws), *args], capture_output=True, text=True, check=check)


def hostname() -> str:
    h = os.environ.get("MOTHER_HOSTNAME") or socket.gethostname()
    return h.split(".")[0].lower()

# ---------------------------------------------------------------- config

def load_config(ws: Path) -> dict:
    p = ws / "config.json"
    if not p.is_file():
        die(f"{p} not found — run /mother:setup")
    try:
        return json.loads(p.read_text())
    except json.JSONDecodeError as e:
        die(f"config.json is not valid JSON: {e}")


def save_config(ws: Path, cfg: dict) -> None:
    (ws / "config.json").write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")


TOP_KEYS = {"version", "agent", "manager", "workspace", "connectors", "teams", "routines", "policy", "whatsapp", "hub"}
MODES = {"off", "watch", "mention", "draft", "auto"}
TRIGGERS = {"manager", "team", "anyone"}
DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
WA_KEYS = {"enabled", "self_jid", "max_per_day", "min_gap_seconds", "read", "send"}
WA_LEGACY_KEYS = {"allow", "approve_via", "max_prompts_per_day"}  # the earlier design: accepted, ignored
WA_MAX_PER_DAY_CEILING = 50
WA_USER_JID_RE = re.compile(r"\d{6,15}@s\.whatsapp\.net", re.ASCII)


HUB_KEYS = {"enabled", "every_seconds", "idle_every_seconds", "model", "max_cards_per_wake", "sweep_minutes",
            "update_ttl_hours", "connections", "watch"}
HUB_CAPS = ("chat", "mail", "tracker", "calendar", "code", "whatsapp")
HUB_CONN_KEYS = {"command", "args", "env", "cli", "local"}
HUB_WATCH_KEYS = {"chat": {"channels"}, "mail": {"ignore_senders", "ignore_labels"},
                  "tracker": {"projects", "extra_jql"}, "calendar": {"lead_minutes"}, "code": {"repos"},
                  "whatsapp": {"groups"}}


TICK_EVERY = (30, 60, 120, 180, 240)
TICK_KEYS = {"every", "active_hours", "days", "thresholds", "signals", "notify", "slow_every", "max_age_days"}


def _tick_hours(active):
    """(start, end) in minutes since midnight for 'HH:MM-HH:MM', or None when malformed or start >= end."""
    m = re.fullmatch(r"([01]\d|2[0-3]):([0-5]\d)-([01]\d|2[0-3]):([0-5]\d)", active) if isinstance(active, str) else None
    if not m:
        return None
    a, b = int(m[1]) * 60 + int(m[2]), int(m[3]) * 60 + int(m[4])
    return (a, b) if a < b else None


def _manager_tz(cfg: dict):
    """manager.timezone as a tzinfo; UTC when unset or unknown (validate reports a bad zone elsewhere)."""
    from zoneinfo import ZoneInfo
    try:
        return ZoneInfo((cfg.get("manager") or {}).get("timezone") or "UTC")
    except Exception:
        return _dt.timezone.utc


def _tick_offset(cfg: dict, now: _dt.datetime) -> int:
    """Minutes to add to a manager.timezone clock time to get this machine's clock time, at today's offsets."""
    tz = _manager_tz(cfg)
    day = now.astimezone(tz).date()
    noon = _dt.datetime(day.year, day.month, day.day, 12, tzinfo=tz)
    return int((noon.astimezone().utcoffset() - noon.utcoffset()).total_seconds() // 60)


def _tick_slots(every: int, a: int, b: int) -> list:
    """Tick slots in minutes since midnight, manager time: :05 (and :35 for 30-minute) of each step hour."""
    return [h * 60 + m for h in range(a // 60, -(-b // 60), max(1, every // 60))
            for m in ((5, 35) if every == 30 else (5,))]


TICK_OFFSET_CHANGED = "re-run mother register (time-zone offset changed)"
TICK_MIDNIGHT = ("routines.tick.active_hours crosses midnight in this machine's time zone; narrow active_hours, "
                 "or run tick on a machine whose time zone is nearer manager.timezone")


def _tick_crosses_midnight(r: dict, cfg: dict, now: _dt.datetime) -> bool:
    hours = _tick_hours(r.get("active_hours", "06:00-22:00"))
    every = r.get("every", 60)
    if hours is None or every not in TICK_EVERY:
        return False
    d = _tick_offset(cfg, now)
    slots = _tick_slots(every, *hours)
    return min([hours[0]] + slots) + d < 0 or max(hours[1], max(slots) + 1) + d > 24 * 60


def _tick_registered_offset(ws: Path):
    """The manager->machine offset (minutes) the registered tick cron was built with, or None if unknown."""
    try:
        v = json.loads((ws / ".mother" / "tick-register.json").read_text()).get("offset_minutes")
    except (OSError, ValueError, AttributeError):
        return None
    return v if isinstance(v, int) and not isinstance(v, bool) else None


def validate(cfg: dict) -> list:
    errs = []
    def need(obj, key, typ, where):
        if not isinstance(obj, dict) or key not in obj:
            errs.append(f"missing {where}.{key}")
            return None
        if typ and not isinstance(obj[key], typ):
            errs.append(f"{where}.{key} should be {typ.__name__ if isinstance(typ, type) else typ}")
        return obj[key]

    if not isinstance(cfg, dict):
        return ["config must be a JSON object"]
    for k in cfg:
        if k not in TOP_KEYS:
            errs.append(f"unknown top-level key '{k}'")
    if cfg.get("version") != 1:
        errs.append("version must be 1")
    agent = need(cfg, "agent", dict, "config") or {}
    for k in ("name", "manager", "manager_short"):
        need(agent, k, str, "agent")
    mgr = need(cfg, "manager", dict, "config") or {}
    for k in ("email", "timezone"):
        need(mgr, k, str, "manager")
    dm = need(mgr, "chat_dm", None, "manager")
    if dm is not None and not (isinstance(dm, str) or (isinstance(dm, list) and dm and all(isinstance(x, str) for x in dm))):
        errs.append("manager.chat_dm must be a string or a non-empty list of strings")
    if "chat_user" in mgr and not isinstance(mgr["chat_user"], str):
        errs.append("manager.chat_user must be a string")
    if "tracker_account" in mgr and not isinstance(mgr["tracker_account"], str):
        errs.append("manager.tracker_account must be a string")
    wd = mgr.get("workdays", DAYS[:5])
    if not isinstance(wd, list) or any(d not in DAYS for d in wd):
        errs.append(f"manager.workdays must be a list of {DAYS}")
    wsc = need(cfg, "workspace", dict, "config") or {}
    for k in ("git_remote", "home_machine"):
        if k in wsc and wsc[k] is not None and not isinstance(wsc[k], str):
            errs.append(f"workspace.{k} must be a string or null")
    for i, t in enumerate(cfg.get("teams") or []):
        where = f"teams[{i}]"
        need(t, "slug", str, where)
        need(t, "name", str, where)
        for j, pp in enumerate(t.get("people") or []):
            oo = pp.get("one_on_one") if isinstance(pp, dict) else None
            if oo is None:
                continue
            cd = oo.get("cadence_days") if isinstance(oo, dict) else None
            if not isinstance(oo, dict) or any(k not in ("cadence_days", "title") for k in oo) \
                    or (cd is not None and (not isinstance(cd, int) or isinstance(cd, bool) or not 3 <= cd <= 90)) \
                    or not isinstance(oo.get("title", ""), str):
                errs.append(f"{where}.people[{j}].one_on_one must be {{cadence_days: 3-90, title: str}}")
        for j, ch in enumerate(t.get("channels") or []):
            cw = f"{where}.channels[{j}]"
            need(ch, "id", str, cw)
            if ch.get("mode", "watch") not in MODES:
                errs.append(f"{cw}.mode must be one of {sorted(MODES)}")
            if ch.get("trigger", "manager") not in TRIGGERS:
                errs.append(f"{cw}.trigger must be one of {sorted(TRIGGERS)}")
            if ch.get("external") and ch.get("mode") == "auto":
                errs.append(f"{cw}: external channels are capped at mention/draft")
            if ch.get("external") and ch.get("mode") == "mention" and ch.get("trigger", "manager") != "manager":
                errs.append(f"{cw}: external channels can only be triggered by the manager")
            at = ch.get("auto_topics")
            if at is not None and not (isinstance(at, list) and all(isinstance(x, str) and re.fullmatch(r"[a-z0-9][a-z0-9-]{0,60}", x) for x in at)):
                errs.append(f"{cw}.auto_topics must be a list of lowercase-dashed topic slugs")
            mr = ch.get("max_replies_per_hour")
            if mr is not None and (not isinstance(mr, int) or isinstance(mr, bool) or mr < 1):
                errs.append(f"{cw}.max_replies_per_hour must be a positive integer")
            qh = ch.get("quiet_hours")
            if qh is not None and not (isinstance(qh, str) and re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d-([01]\d|2[0-3]):[0-5]\d", qh)):
                errs.append(f"{cw}.quiet_hours must be HH:MM-HH:MM")
    for rid, r in (cfg.get("routines") or {}).items():
        if not isinstance(r, dict):
            errs.append(f"routines.{rid} must be an object")
        else:
            if "at" in r and not re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", str(r["at"])):
                errs.append(f"routines.{rid}.at must be HH:MM")
            d = r.get("days")
            ok = (d is None or d in ("workdays", "all") or (isinstance(d, str) and (d in DAYS or re.fullmatch(r"monthly:([1-9]|1\d|2[0-8])", d)))
                  or (isinstance(d, list) and d and all(x in DAYS for x in d)))
            if not ok:
                errs.append(f"routines.{rid}.days must be workdays, all, a day, a list of days, or monthly:<1-28>")
            if rid == "tick" and isinstance(d, str) and d.startswith("monthly:"):
                errs.append("routines.tick.days must be workdays, all, a day, or a list of days")
            if rid == "brief" and "draft_replies" in r and not isinstance(r["draft_replies"], bool):
                errs.append("routines.brief.draft_replies must be true or false")
            if rid == "brief" and r.get("gather", "inline") not in ("inline", "readers"):
                errs.append("routines.brief.gather must be inline or readers")
            au = r.get("audio") if rid == "brief" else None
            if au is not None and not (au is True or au is False or (isinstance(au, dict) and all(
                    k in ("voice", "voice_he", "rate", "language", "save_to", "engine", "kokoro_voice") for k in au)
                    and au.get("engine", "say") in ("say", "kokoro")
                    and au.get("language", "en") in ("en", "he")
                    and (au.get("rate") is None or (isinstance(au["rate"], int) and 90 <= au["rate"] <= 360)))):
                errs.append("routines.brief.audio must be true/false or {voice, voice_he, rate 90-360, language en|he, save_to, engine say|kokoro, kokoro_voice}")
            if rid == "tick":
                sys.path.insert(0, str(PLUGIN_ROOT / "lib"))
                import now as _now_mod
                for k in r:
                    if k not in TICK_KEYS:
                        errs.append(f"routines.tick.{k} is not a known key")
                ev = r.get("every")
                if ev is not None and (not isinstance(ev, int) or isinstance(ev, bool) or ev not in TICK_EVERY):
                    errs.append("routines.tick.every must be one of " + ", ".join(str(x) for x in TICK_EVERY))
                ah = r.get("active_hours")
                if ah is not None and _tick_hours(ah) is None:
                    errs.append("routines.tick.active_hours must be HH:MM-HH:MM with start before end")
                th = r.get("thresholds")
                if th is not None and not isinstance(th, dict):
                    errs.append("routines.tick.thresholds must be an object")
                for sig, v in (th if isinstance(th, dict) else {}).items():
                    if sig not in _now_mod.SIGNALS:
                        errs.append(f"routines.tick.thresholds.{sig} is not a known signal")
                    elif not (v == 0 and not isinstance(v, bool)) and not (isinstance(v, str) and re.fullmatch(r"\d+[hd]", v)):
                        errs.append(f"routines.tick.thresholds.{sig} must be Nh, Nd or 0")
                sg = r.get("signals")
                if sg is not None and not isinstance(sg, dict):
                    errs.append("routines.tick.signals must be an object")
                for sig, v in (sg if isinstance(sg, dict) else {}).items():
                    if sig not in _now_mod.SIGNALS:
                        errs.append(f"routines.tick.signals.{sig} is not a known signal")
                    elif not isinstance(v, bool):
                        errs.append(f"routines.tick.signals.{sig} must be true or false")
                if r.get("notify", "none") not in ("none", "dm"):
                    errs.append("routines.tick.notify must be none or dm")
                se = r.get("slow_every")
                if se is not None and (not isinstance(se, int) or isinstance(se, bool) or not 1 <= se <= 6):
                    errs.append("routines.tick.slow_every must be an integer 1-6")
                ma = r.get("max_age_days")
                if ma is not None and (not isinstance(ma, int) or isinstance(ma, bool) or not 0 <= ma <= 365):
                    errs.append("routines.tick.max_age_days must be an integer 0-365")
            if rid == "commitments":
                for k, lo, hi in (("no_reply_days", 1, 30), ("lookback_days", 1, 60)):
                    v = r.get(k)
                    if v is not None and (not isinstance(v, int) or isinstance(v, bool) or not lo <= v <= hi):
                        errs.append(f"routines.commitments.{k} must be an integer {lo}-{hi}")
                if "draft_nudges" in r and not isinstance(r["draft_nudges"], bool):
                    errs.append("routines.commitments.draft_nudges must be true or false")
    pol = cfg.get("policy")
    if pol is not None and not isinstance(pol, dict):
        errs.append("policy must be an object")
    elif isinstance(pol, dict) and "bypass_passes_asks" in pol and not isinstance(pol["bypass_passes_asks"], bool):
        errs.append("policy.bypass_passes_asks must be true or false")
    if "whatsapp" in cfg:
        errs.extend(validate_whatsapp(cfg["whatsapp"]))
    if "hub" in cfg:
        errs.extend(validate_hub(cfg["hub"]))
    return errs


def validate_hub(h) -> list:
    errs = []
    if not isinstance(h, dict):
        return ["hub must be an object"]

    def is_int(v):
        return isinstance(v, int) and not isinstance(v, bool)

    def str_list(v):
        return isinstance(v, list) and all(isinstance(x, str) for x in v)
    for k in h:
        if k not in HUB_KEYS:
            errs.append(f"unknown key hub.{k}")
    if "enabled" in h and not isinstance(h["enabled"], bool):
        errs.append("hub.enabled must be true or false")
    for k, lo, hi in (("every_seconds", 30, 3600), ("idle_every_seconds", 0, 86400), ("max_cards_per_wake", 1, 3),
                      ("sweep_minutes", 10, 240), ("update_ttl_hours", 1, 168)):
        if k in h and (not is_int(h[k]) or not lo <= h[k] <= hi):
            errs.append(f"hub.{k} must be an integer {lo}-{hi}")
    if h.get("model") is not None and not isinstance(h["model"], str):
        errs.append("hub.model must be a string or null")
    conns = h.get("connections", {})
    if not isinstance(conns, dict):
        errs.append("hub.connections must be an object")
        conns = {}
    for cap, c in conns.items():
        where = f"hub.connections.{cap}"
        if cap not in HUB_CAPS:
            errs.append(f"unknown capability {where} (expected one of {', '.join(HUB_CAPS)})")
            continue
        if not isinstance(c, dict):
            errs.append(f"{where} must be an object")
            continue
        for k in c:
            if k not in HUB_CONN_KEYS:
                errs.append(f"unknown key {where}.{k}")
        if cap == "whatsapp" or "local" in c:
            if cap != "whatsapp" or c.get("local") != "whatsapp":
                errs.append(f'{where} must be {{"local": "whatsapp"}} (and only the whatsapp capability takes it)')
            elif set(c) != {"local"}:
                errs.append(f"{where} takes only local")
        elif "cli" in c:
            if c["cli"] != "gh":
                errs.append(f'{where}.cli must be "gh"')
        elif not (isinstance(c.get("command"), str) and c["command"]):
            errs.append(f"{where} needs a command (string) or cli (\"gh\")")
        if "args" in c and not str_list(c["args"]):
            errs.append(f"{where}.args must be a list of strings")
        if "env" in c and not (isinstance(c["env"], dict)
                               and all(isinstance(a, str) and isinstance(b, str) for a, b in c["env"].items())):
            errs.append(f"{where}.env must map strings to strings")
    watch = h.get("watch", {})
    if not isinstance(watch, dict):
        errs.append("hub.watch must be an object")
        watch = {}
    for src, w in watch.items():
        where = f"hub.watch.{src}"
        if src not in HUB_WATCH_KEYS:
            errs.append(f"unknown key {where}")
            continue
        if not isinstance(w, dict):
            errs.append(f"{where} must be an object")
            continue
        for k, v in w.items():
            if k not in HUB_WATCH_KEYS[src]:
                errs.append(f"unknown key {where}.{k}")
            elif k == "lead_minutes":
                if not is_int(v) or v < 0:
                    errs.append(f"{where}.{k} must be an integer >= 0")
            elif k == "extra_jql":
                if v is not None and not isinstance(v, str):
                    errs.append(f"{where}.{k} must be a string or null")
            elif not str_list(v):
                errs.append(f"{where}.{k} must be a list of strings")
    return errs


def validate_whatsapp(wa) -> list:
    errs = []
    if not isinstance(wa, dict):
        return ["whatsapp must be an object"]
    for k in wa:
        if k not in WA_KEYS and k not in WA_LEGACY_KEYS:
            errs.append(f"unknown key whatsapp.{k}")

    def is_int(v):
        return isinstance(v, int) and not isinstance(v, bool)
    for k in ("enabled", "read", "send"):
        if k in wa and not isinstance(wa[k], bool):
            errs.append(f"whatsapp.{k} must be true or false")
    sj = wa.get("self_jid")
    if sj is None:
        if wa.get("enabled") is True:
            errs.append("missing whatsapp.self_jid (required when whatsapp.enabled is true)")
    elif not (isinstance(sj, str) and WA_USER_JID_RE.fullmatch(sj)):
        errs.append("whatsapp.self_jid must be <digits>@s.whatsapp.net")
    v = wa.get("max_per_day")
    if v is not None and (not is_int(v) or not 1 <= v <= WA_MAX_PER_DAY_CEILING):
        errs.append(f"whatsapp.max_per_day must be an integer 1-{WA_MAX_PER_DAY_CEILING}")
    v = wa.get("min_gap_seconds")
    if v is not None and (not is_int(v) or v < 0):
        errs.append("whatsapp.min_gap_seconds must be an integer >= 0")
    return errs

# ---------------------------------------------------------------- secret scan

# Narrow on purpose: false positives train people to ignore the scanner.
SECRET_PATTERNS = [
    r"gh[pousr]_[A-Za-z0-9]{20,}",
    r"github_pat_[A-Za-z0-9_]{20,}",
    r"sk-[A-Za-z0-9_-]{20,}",
    r"xox[baprs]-[A-Za-z0-9-]{10,}",
    r"AKIA[0-9A-Z]{16}",
    r"AIza[0-9A-Za-z_-]{30,}",
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"(?i)(password|passwd|secret|api[_-]?key|access[_-]?token|bearer)\s*[:=]\s*[\"']?[A-Za-z0-9_+/.=-]{16,}",
]
_SECRET_RE = [re.compile(p) for p in SECRET_PATTERNS]


def scan_files(paths) -> list:
    hits = []
    for p in paths:
        p = Path(p)
        if not p.is_file():
            continue
        try:
            data = p.read_bytes()
        except OSError:
            continue
        if b"\0" in data[:8192]:
            continue  # binary: cannot vouch for it
        text = data.decode("utf-8", "replace")
        for n, line in enumerate(text.splitlines(), 1):
            for rx in _SECRET_RE:
                if rx.search(line):
                    hits.append(f"{p}:{n}: {line.strip()[:100]}")
                    break
    return hits


def changed_files(ws: Path) -> list:
    out = git(ws, "ls-files", "--others", "--exclude-standard", "--modified").stdout
    return [ws / f for f in out.splitlines() if f]


def cmd_scan(args):
    ws = workspace()
    files = [Path(a) for a in args] if args else changed_files(ws)
    hits = scan_files(files)
    for h in hits:
        print(f"SECRET-SCAN: {h}", file=sys.stderr)
    if hits:
        print("Refusing to proceed. Remove the credential, then rotate it.", file=sys.stderr)
        sys.exit(1)
    print(f"clean ({len(files)} file(s) scanned)")

# ---------------------------------------------------------------- init / join

def cmd_init(args):
    if not args:
        die("usage: mother init <path> [--remote URL]")
    remote = None
    if "--remote" in args:
        i = args.index("--remote")
        remote = args[i + 1] if i + 1 < len(args) else die("--remote needs a URL")
        args = args[:i] + args[i + 2:]
    ws = Path(args[0]).expanduser()
    if ws.exists() and any(ws.iterdir()) and not (ws / "config.json").exists() and not (ws / "AGENTS.md").exists():
        die(f"{ws} exists, isn't empty, and doesn't look like a workspace — pick another path")
    ws.mkdir(parents=True, exist_ok=True)
    # Copy the template without overwriting anything that exists (safe to re-run, and safe to adopt
    # an existing workspace such as a pre-mother agent repo).
    created = []
    for src in TEMPLATE.rglob("*"):
        rel = src.relative_to(TEMPLATE)
        if rel.name == "config.example.json":
            continue
        dst = ws / rel
        if src.is_dir():
            dst.mkdir(parents=True, exist_ok=True)
        elif not dst.exists():
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
            created.append(str(rel))
    (ws / ".mother").mkdir(exist_ok=True)
    # An adopted workspace keeps its own .gitignore, but must still ignore mother's machine-local state.
    gi = ws / ".gitignore"
    have = set(gi.read_text().splitlines()) if gi.exists() else set()
    need = [l for l in (TEMPLATE / ".gitignore").read_text().splitlines() if l and not l.startswith("#") and l not in have]
    if need:
        with gi.open("a") as f:
            f.write(("\n" if have else "") + "# added by mother init\n" + "\n".join(need) + "\n")
    if not (ws / ".git").exists():
        git(ws, "init", "-q", "-b", "main")
    if remote:
        if git(ws, "remote", "get-url", "origin").returncode == 0:
            git(ws, "remote", "set-url", "origin", remote)
        else:
            git(ws, "remote", "add", "origin", remote)
        cfg_path = ws / "config.json"
        if cfg_path.is_file():
            cfg = json.loads(cfg_path.read_text())
            cfg.setdefault("workspace", {})["git_remote"] = remote
            save_config(ws, cfg)
    set_pointer(ws)
    print(f"workspace ready at {ws.resolve()} ({len(created)} file(s) created)")
    print("next: /mother:setup to fill config.json, then /mother:doctor")


def cmd_join(args):
    if not args:
        die("usage: mother join <git-url> [path]")
    url = args[0]
    dest = Path(args[1]).expanduser() if len(args) > 1 else Path.home() / Path(url.rstrip("/").split("/")[-1]).stem
    if dest.exists() and any(dest.iterdir()):
        if not (dest / ".git").exists():
            die(f"{dest} exists and isn't a git checkout")
    else:
        r = subprocess.run(["git", "clone", "-q", url, str(dest)], capture_output=True, text=True)
        if r.returncode:
            die(f"clone failed: {r.stderr.strip()}")
    (dest / ".mother").mkdir(exist_ok=True)
    set_pointer(dest)
    cfg = json.loads((dest / "config.json").read_text()) if (dest / "config.json").is_file() else {}
    home = (cfg.get("workspace") or {}).get("home_machine")
    print(f"joined workspace at {dest.resolve()}")
    print(f"routines run on: {home or 'not set'} (this machine: {hostname()})")
    print("next: connect your connectors here, then /mother:doctor. Don't register routines on a second machine.")

# ---------------------------------------------------------------- sync

def _only_tick_runs(ws: Path) -> bool:
    """True when the only change in the workspace is runs.md lines appended by the tick routine.
    The hourly tick ends through the Stop/SessionEnd hooks' `sync --quiet`; committing for those lines alone
    would add a commit and a push every hour. The next non-tick sync carries them."""
    if git(ws, "status", "--porcelain", "--untracked-files=all").stdout.splitlines() != [" M runs.md"]:
        return False
    diff = git(ws, "diff", "--no-color", "--unified=0", "--", "runs.md").stdout.splitlines()
    added = 0
    for line in diff:
        if line.startswith(("diff ", "index ", "--- ", "+++ ", "@@")):
            continue
        if not line.startswith("+"):
            return False                       # a removed or changed line: not a plain append
        m = RUN_LINE.match(line[1:].strip())
        if not m or m.group(2) != "tick":
            return False
        added += 1
    return added > 0


def cmd_sync(args):
    quiet = "--quiet" in args
    def say(m):
        if not quiet:
            print(f"mother sync: {m}")
    def warn(m):
        print(f"mother sync: {m}", file=sys.stderr)
    if os.environ.get("MOTHER_NO_SYNC"):
        return  # a channel reply session: the loop's own session syncs, and parallel syncs collide on git
    ws, tick_only = None, False
    try:
        ws = workspace(required=False)
        if not ws or not (ws / ".git").exists():
            return
        if git(ws, "symbolic-ref", "--quiet", "--short", "HEAD").returncode:
            warn("detached HEAD, skipping")
            return
        gitdir = Path(git(ws, "rev-parse", "--absolute-git-dir").stdout.strip())
        if (gitdir / "rebase-merge").exists() or (gitdir / "rebase-apply").exists() or (gitdir / "MERGE_HEAD").exists():
            warn("rebase/merge in progress, skipping")
            return
        branch = git(ws, "symbolic-ref", "--short", "HEAD").stdout.strip()
        if (ws / "QUARANTINE.md").exists():
            warn("QUARANTINE.md present — not committing until it is resolved and deleted")
            return
        if quiet and _only_tick_runs(ws):
            tick_only = True
            return                             # the hook path after a tick: no hourly commit or push
        if git(ws, "status", "--porcelain").stdout.strip():
            hits = scan_files(changed_files(ws))
            if hits:
                (ws / "QUARANTINE.md").write_text(
                    "# QUARANTINE — nothing was committed\n\n"
                    f"The secret scan matched credential-shaped content at {now_iso()}:\n\n```\n"
                    + "\n".join(hits) + "\n```\n\nRemove the credential, rotate it, then delete this file.\n")
                warn("ABORTED — credential-shaped content found; see QUARANTINE.md")
                return
            git(ws, "add", "-A")
            if git(ws, "diff", "--cached", "--quiet").returncode:
                n = len(git(ws, "diff", "--cached", "--name-only").stdout.splitlines())
                r = git(ws, "commit", "--no-verify", "-q", "-m", f"chore(sync): {now_iso()} ({n} file(s))")
                if r.returncode:
                    warn(f"commit failed: {r.stderr.strip()}")
                    return
                say(f"committed {n} file(s)")
        if git(ws, "rev-parse", "--verify", "--quiet", "@{upstream}").returncode:
            if git(ws, "remote").stdout.strip():
                if git(ws, "push", "-q", "-u", "origin", branch).returncode == 0:
                    say("pushed (upstream set)")
                else:
                    warn("push failed; work is committed locally")
            return
        if not git(ws, "log", "--oneline", "@{upstream}..HEAD").stdout.strip():
            return
        for _ in range(3):
            if git(ws, "push", "-q").returncode == 0:
                say("pushed")
                return
            if git(ws, "fetch", "-q", "origin", branch).returncode:
                warn("committed locally; fetch failed (offline?) — next sync carries it")
                return
            if git(ws, "rebase", "--autostash", "-q", f"origin/{branch}").returncode:
                git(ws, "rebase", "--abort")
                warn(f"cannot rebase onto origin/{branch} automatically (conflict). Work IS committed locally; run `git pull --rebase` in the workspace.")
                return
        warn("push still rejected after 3 tries; work is safe locally")
    finally:
        try:
            if ws and not tick_only and (ws / ".mother").is_dir():
                (ws / ".mother" / "last-sync").write_text(now_iso() + "\n")
        except Exception:
            pass

# ---------------------------------------------------------------- home machine

def cmd_home(args):
    ws = workspace()
    cfg = load_config(ws)
    wsc = cfg.setdefault("workspace", {})
    sub = args[0] if args else "show"
    here = hostname()
    if sub == "show":
        print(f"home: {wsc.get('home_machine') or 'not set'}; this machine: {here}")
    elif sub in ("set", "move"):
        target = (args[1] if len(args) > 1 else here).lower()
        old = wsc.get("home_machine")
        if sub == "set" and old and old != target:
            die(f"home is already {old}; use `mother home move {target}` to change it deliberately")
        wsc["home_machine"] = target
        save_config(ws, cfg)
        print(f"home machine: {target}" + (f" (was {old})" if old and old != target else ""))
        if old and old != target:
            print(f"Remove the scheduled routines on {old}, then register them on {target}.")
    elif sub == "check":
        home = wsc.get("home_machine")
        if not home:
            print("home machine not set — routines refuse to run until `mother home set`", file=sys.stderr)
            sys.exit(3)
        if home != here:
            print(f"not the home machine ({here}); routines run on {home}", file=sys.stderr)
            sys.exit(2)
        print(f"home machine: {here}")
    else:
        die("usage: mother home show|set [host]|check|move <host>")

# ---------------------------------------------------------------- status / register

def plugin_enabled():
    """True/False from the user's Claude Code settings (enabledPlugins["mother@mother"]), None if unknown."""
    cdir = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    try:
        v = (json.loads((cdir / "settings.json").read_text()).get("enabledPlugins") or {}).get("mother@mother")
    except (OSError, json.JSONDecodeError, AttributeError):
        return None
    return v if isinstance(v, bool) else None


def health_status_line(ws, cfg) -> str:
    """Open connector-health issues for `mother status`; never raises."""
    sys.path.insert(0, str(PLUGIN_ROOT / "lib"))
    import health
    try:
        caps = health.normalize(health.load(ws), cfg)
        kinds = {v: k for k, v in (cfg.get("connectors") or {}).items() if isinstance(v, str)}
        opened, covered = [], 0
        for vendor, conn in sorted((caps.get("connectors") or {}).items()):
            if not isinstance(conn, dict):
                continue
            for server, entries in sorted((conn.get("health") or {}).items()):
                for cap, e in sorted((entries or {}).items()):
                    if cap.startswith("_") or not isinstance(e, dict) or e.get("status") in ("ok", "untested"):
                        continue
                    if health.rollup(conn, cap) == "ok":
                        covered += 1
                    else:
                        opened.append("%s.%s %s %s" % (kinds.get(vendor, vendor), cap, health.server_short(server),
                                                       e.get("class") or "other"))
    except (health.HealthError, AttributeError, TypeError):
        return "capabilities.json unreadable — run /mother:doctor"
    if not opened and not covered:
        return "ok"
    note = f" (+{covered} covered by fallback)" if covered else ""
    if not opened:
        return "ok" + note
    shown = "; ".join(opened[:3]) + ("; …" if len(opened) > 3 else "")
    return f"{len(opened)} open — {shown}{note}"


def cmd_status(args):
    ws = workspace()
    cfg = load_config(ws)
    errs = validate(cfg)
    wsc = cfg.get("workspace") or {}
    remote = git(ws, "remote", "get-url", "origin").stdout.strip() or None
    last = (ws / ".mother" / "last-sync")
    caps = ws / "capabilities.json"
    print(f"workspace:   {ws}")
    print(f"agent:       {(cfg.get('agent') or {}).get('name', '?')} on behalf of {(cfg.get('agent') or {}).get('manager_short', '?')}")
    print(f"remote:      {remote or 'none (local only)'}")
    print(f"home:        {wsc.get('home_machine') or 'not set'} (this machine: {hostname()})")
    print(f"last sync:   {last.read_text().strip() if last.is_file() else 'never'}")
    if caps.is_file():
        try:
            print(f"doctor:      {json.loads(caps.read_text()).get('checked_at', '?')}")
        except json.JSONDecodeError:
            print("doctor:      capabilities.json unreadable — run /mother:doctor")
    else:
        print("doctor:      never run — run /mother:doctor")
    if caps.is_file():
        print("health:      " + health_status_line(ws, cfg))
    pe = plugin_enabled()
    if pe is False:
        print("plugin:      DISABLED — the approval guard and the sync hook don't run; `claude plugin enable mother@mother`")
    elif pe:
        print("plugin:      enabled")
    if (ws / "QUARANTINE.md").exists():
        print("WARNING:     QUARANTINE.md present — sync is blocked until it's resolved")
    if (ws / ".mother" / "PAUSED").exists():
        print("PAUSED:      outbound actions are paused (.mother/PAUSED)")
    if errs:
        print("config:      INVALID")
        for e in errs:
            print(f"  - {e}")
        sys.exit(1)
    print("config:      valid")
    rows = routine_health(ws, cfg)
    bad = [f"{r['id']} {r['state']}" for r in rows if r["state"] in ("missed", "failed")]
    for r in rows:
        if r["id"] == "tick" and r["note"] in (TICK_MIDNIGHT, TICK_OFFSET_CHANGED):
            print(f"tick:        WARNING — {r['note']}")
    print(f"routines:    {'; '.join(bad) + ' — see `mother runs`' if bad else 'all scheduled runs logged'}")


def _cron(at: str, days, workdays) -> str:
    hh, mm = at.split(":")
    if isinstance(days, str) and days.startswith("monthly:"):
        return f"{int(mm)} {int(hh)} {int(days.split(':', 1)[1])} * *"
    if days in (None, "workdays"):
        days = workdays
    elif days == "all":
        days = DAYS
    elif isinstance(days, str):
        days = [days]
    idx = sorted({(DAYS.index(d) + 1) % 7 for d in days})  # cron: Sun=0
    dow = "*" if len(idx) == 7 else ",".join(str(i) for i in idx)
    return f"{int(mm)} {int(hh)} * * {dow}"


def _interval_cron(every: int, active: str, days, workdays, offset: int = 0) -> str:
    """Cron for an interval routine: slots at minute :05 (and :35 for 30-minute) of manager.timezone, hourly
    steps inside active hours, moved by `offset` minutes into the machine's clock (cron runs in machine time).
    A half-hour offset moves :05 to :35. The caller has refused a window that crosses machine midnight."""
    a, b = _tick_hours(active)
    local = [x + offset for x in _tick_slots(every, a, b)]
    mins = sorted({x % 60 for x in local})
    hours = sorted({x // 60 for x in local})
    run = hours == list(range(hours[0], hours[-1] + 1))
    hh = f"{hours[0]}-{hours[-1]}" if len(hours) > 1 and every <= 60 and run else ",".join(str(h) for h in hours)
    return f"{','.join(str(m) for m in mins)} {hh} " + _cron("00:00", days, workdays).split(" ", 2)[2]


def _pointer(ws: Path, rid: str, team: str = None, pull: bool = True) -> str:
    who = f" for team {team}" if team else ""
    lead = (f'cd "{ws}" and run `git pull --rebase --autostash -q` if the workspace has a remote (on failure, continue with the '
            f"local copy and say so). Then invoke" if pull else f'cd "{ws}". Invoke')
    return (f"{lead} the mother:routine skill with routine id `{rid}`{who}. "
            "All behaviour lives in the mother plugin's routines/ files and the workspace config; this pointer "
            "carries no other instructions. Always append a line to runs.md, including on failure.")


def cmd_register(args):
    ws = workspace()
    cfg = load_config(ws)
    errs = validate(cfg)
    if errs:
        die("config invalid — run `mother status`")
    workdays = (cfg.get("manager") or {}).get("workdays") or DAYS[:5]
    tasks, problems = [], []
    for rid, r in (cfg.get("routines") or {}).items():
        if rid == "tick" and isinstance(r, dict):
            if _tick_crosses_midnight(r, cfg, _now()):
                problems.append(TICK_MIDNIGHT)          # tick is not registered; the other routines are
                continue
            every, active = r.get("every", 60), r.get("active_hours", "06:00-22:00")
            offset = _tick_offset(cfg, _now())
            tasks.append({"taskId": "mother-tick", "title": f"Mother: tick (every {every} min, {active})",
                          "cronExpression": _interval_cron(every, active, r.get("days"), workdays, offset),
                          "prompt": _pointer(ws, "tick", pull=False), "offset_minutes": offset})
            try:
                (ws / ".mother").mkdir(exist_ok=True)
                (ws / ".mother" / "tick-register.json").write_text(
                    json.dumps({"offset_minutes": offset, "registered_at": now_iso()}) + "\n")
            except OSError:
                pass
            continue
        if rid == "meeting" or not isinstance(r, dict) or "at" not in r:
            continue
        tasks.append({"taskId": f"mother-{rid}", "title": f"Mother: {rid} ({r['at']})",
                      "cronExpression": _cron(r["at"], r.get("days"), workdays), "prompt": _pointer(ws, rid)})
    if (cfg.get("routines") or {}).get("meeting"):
        for t in cfg.get("teams") or []:
            wk = (t.get("meetings") or {}).get("weekly")
            if not wk or not wk.get("day") or not wk.get("time"):
                continue
            prep_day, prep_at = (wk.get("prep_at") or f"{wk['day']} 07:00").split()
            tasks.append({"taskId": f"mother-meeting-prep-{t['slug']}", "title": f"Mother: {t['name']} meeting prep",
                          "cronExpression": _cron(prep_at, prep_day, workdays),
                          "prompt": _pointer(ws, "meeting-prep", t["slug"])})
            hh, mm = wk["time"].split(":")
            recap = f"{(int(hh) + 1) % 24:02d}:{mm}"
            tasks.append({"taskId": f"mother-meeting-recap-{t['slug']}", "title": f"Mother: {t['name']} recap draft",
                          "cronExpression": _cron(recap, wk["day"], workdays),
                          "prompt": _pointer(ws, "meeting-recap", t["slug"])})
    out = {"home_machine": (cfg.get("workspace") or {}).get("home_machine"), "tasks": tasks}
    if problems:
        out["errors"] = problems
    print(json.dumps(out, indent=2))
    for m in problems:
        print(f"mother register: {m}", file=sys.stderr)
    if problems:
        sys.exit(2)

# ---------------------------------------------------------------- runs (watchdog)

RUN_LINE = re.compile(r"^- (\d{4}-\d\d-\d\dT\d\d:\d\d(?::\d\d)?Z) (\S+) (ok|partial|failed|skipped)\b(?:\s*[—-]+\s*(.*))?")
MISSED_GRACE = _dt.timedelta(hours=2)  # a missed desktop run fires on the next launch; give it time


def _now() -> _dt.datetime:
    env = os.environ.get("MOTHER_NOW")  # tests pin the clock
    if env:
        return _dt.datetime.strptime(env, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=_dt.timezone.utc)
    return _dt.datetime.now(_dt.timezone.utc)


def _last_slot(at: str, days, workdays, now: _dt.datetime):
    """Most recent scheduled time at or before `now`, in the machine's local time (the scheduler's convention)."""
    hh, mm = (int(x) for x in at.split(":"))
    local = now.astimezone()
    for back in range(0, 40):
        d = (local - _dt.timedelta(days=back)).date()
        if isinstance(days, str) and days.startswith("monthly:"):
            due = d.day == int(days.split(":", 1)[1])
        else:
            want = workdays if days in (None, "workdays") else DAYS if days == "all" else [days] if isinstance(days, str) else days
            due = DAYS[d.weekday()] in want
        if due:
            slot = _dt.datetime(d.year, d.month, d.day, hh, mm).astimezone()
            if slot <= local:
                return slot.astimezone(_dt.timezone.utc)
    return None


def read_runs(ws: Path) -> dict:
    """{routine id: [(utc datetime, status, note), ...]} oldest first, from runs.md."""
    out = {}
    p = ws / "runs.md"
    if not p.is_file():
        return out
    for line in p.read_text(errors="replace").splitlines():
        m = RUN_LINE.match(line.strip())
        if not m:
            continue
        ts = m.group(1) if m.group(1).count(":") == 2 else m.group(1)[:-1] + ":00Z"
        when = _dt.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=_dt.timezone.utc)
        out.setdefault(m.group(2), []).append((when, m.group(3), (m.group(4) or "").strip()))
    return out


def _log_start(ws: Path, runs: dict):
    """When run logging began: runs.md's first commit or its earliest line. Slots before it aren't misses."""
    times = [h[0] for hist in runs.values() for h in hist]
    added = git(ws, "log", "--diff-filter=A", "--format=%cI", "--", "runs.md").stdout.split()
    if added:
        try:
            times.append(_dt.datetime.fromisoformat(added[-1]).astimezone(_dt.timezone.utc))
        except ValueError:
            pass
    return min(times) if times else None


def _tick_health(r: dict, runs: dict, start, workdays, now: _dt.datetime, cfg: dict = None, registered=None) -> dict:
    """Tick row. Missed only inside active hours on a scheduled day, 2x every after the day's first slot, with no run in 2x every.
    Judged in manager.timezone, the clock lib/now.py and the dispatcher's active-hours gate use."""
    every = r.get("every", 60)
    hours = _tick_hours(r.get("active_hours", "06:00-22:00"))
    days = r.get("days")
    if (hours is None or not isinstance(every, int) or isinstance(every, bool) or every not in TICK_EVERY
            or (isinstance(days, str) and days.startswith("monthly:"))):
        return {"id": "tick", "state": "failed", "expected": None, "last": None, "last_status": None,
                "note": "invalid tick config — run mother status"}
    problem = (TICK_MIDNIGHT if _tick_crosses_midnight(r, cfg or {}, now) else
               TICK_OFFSET_CHANGED if registered is not None and registered != _tick_offset(cfg or {}, now) else None)
    if problem:
        hist = runs.get("tick") or []
        last = hist[-1] if hist else None
        return {"id": "tick", "state": "failed", "expected": None,
                "last": last[0].strftime("%Y-%m-%dT%H:%MZ") if last else None,
                "last_status": last[1] if last else None, "note": problem}
    a, b = hours
    local = now.astimezone(_manager_tz(cfg or {}))
    want = workdays if days in (None, "workdays") else DAYS if days == "all" else [days] if isinstance(days, str) else days
    mins = local.hour * 60 + local.minute
    window = _dt.timedelta(minutes=2 * every)
    hist = runs.get("tick") or []
    last = hist[-1] if hist else None
    first_slot = (a // 60) * 60 + 5 if a % 60 <= 5 else a
    expected = None
    if DAYS[local.weekday()] in want and mins >= a:
        steps = [x for x in _tick_slots(every, a, b) if a <= x < b]
        past = [x for x in steps if x <= mins]
        if past:
            expected = (local.replace(hour=past[-1] // 60, minute=past[-1] % 60, second=0, microsecond=0)).astimezone(_dt.timezone.utc)
    recent = [h for h in hist if now - window <= h[0] <= now]
    overdue = (DAYS[local.weekday()] in want and a <= mins < b and mins >= first_slot + 2 * every
               and not recent and not (start and now - window < start))
    if overdue:
        state = "missed"
    elif last is None:
        state = "pending"
    else:
        state = "ok" if last[1] in ("ok", "skipped") else last[1]
    return {"id": "tick", "state": state, "expected": expected.strftime("%Y-%m-%dT%H:%MZ") if expected else None,
            "last": last[0].strftime("%Y-%m-%dT%H:%MZ") if last else None,
            "last_status": last[1] if last else None, "note": last[2] if last else ""}


def routine_health(ws: Path, cfg: dict) -> list:
    """One row per scheduled routine: {id, state, expected, last, note}. state: ok|partial|failed|missed|pending."""
    now = _now()
    workdays = (cfg.get("manager") or {}).get("workdays") or DAYS[:5]
    runs = read_runs(ws)
    start = _log_start(ws, runs)
    rows = []
    for rid, r in (cfg.get("routines") or {}).items():
        if rid == "tick" and isinstance(r, dict):
            rows.append(_tick_health(r, runs, start, workdays, now, cfg, _tick_registered_offset(ws)))
            continue
        if not isinstance(r, dict) or "at" not in r:
            continue
        slot = _last_slot(r["at"], r.get("days"), workdays, now)
        if slot and now - slot < MISSED_GRACE:  # just due: judge the slot before it
            slot = _last_slot(r["at"], r.get("days"), workdays, slot - _dt.timedelta(minutes=1))
        hist = runs.get(rid) or []
        last = hist[-1] if hist else None
        since = [h for h in hist if slot and h[0] >= slot - _dt.timedelta(minutes=5)]
        if since:
            st = since[-1][1]
            state = "ok" if st in ("ok", "skipped") else st
            last = since[-1]
        elif slot is None or (start and slot < start):
            state = "pending"
        else:
            state = "missed"
        rows.append({"id": rid, "state": state, "expected": slot.strftime("%Y-%m-%dT%H:%MZ") if slot else None,
                     "last": last[0].strftime("%Y-%m-%dT%H:%MZ") if last else None,
                     "last_status": last[1] if last else None, "note": last[2] if last else ""})
    return rows


def cmd_runs(args):
    ws = workspace()
    cfg = load_config(ws)
    rows = routine_health(ws, cfg)
    if "--json" in args:
        print(json.dumps(rows, indent=2))
    else:
        for r in rows:
            if r["state"] == "missed":
                detail = f"no run since {r['expected']}" + (f" (last {r['last']} {r['last_status']})" if r["last"] else " (never ran)")
            elif r["state"] == "pending":
                detail = "not due since logging began"
            else:
                note = r["note"] if len(r["note"]) <= 90 else r["note"][:89] + "…"
                detail = f"{r['last'] or 'never ran'}" + (f" — {note}" if note else "")
            print(f"{r['id']:<16} {r['state'].upper() if r['state'] in ('missed', 'failed') else r['state']:<8} {detail}")
    sys.exit(2 if any(r["state"] in ("missed", "failed") for r in rows) else 0)

# ---------------------------------------------------------------- link

def cmd_link(args):
    d = Path(os.path.expanduser(args[0] if args else "~/.local/bin"))
    # The marketplace clone keeps one path across plugin updates; the versioned cache copy does not.
    stable = Path.home() / ".claude/plugins/marketplaces/mother/bin/mother"
    target = stable if stable.is_file() else Path(__file__).resolve()
    link = d / "mother"
    if link.exists() and not link.is_symlink():
        die(f"{link} exists and is not a symlink; remove it or pass another dir")
    d.mkdir(parents=True, exist_ok=True)
    if link.is_symlink():
        link.unlink()
    link.symlink_to(target)
    print(f"{link} -> {target}")
    if str(d.resolve()) not in [str(Path(x).expanduser().resolve()) for x in os.environ.get("PATH", "").split(os.pathsep) if x]:
        print(f"note: {d} is not on your PATH; add it to your shell profile", file=sys.stderr)

# ---------------------------------------------------------------- speak

HEBREW_RE = re.compile(r"[\u0590-\u05FF]")
AUDIO_KEEP = 14


def _opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            die(f"missing value for {name}")
        return args[i + 1]
    return default


KOKORO_FILES = {
    "kokoro-v1.0.fp16.onnx": "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.fp16.onnx",
    "voices-v1.0.bin": "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin",
}
KOKORO_PKGS = ["kokoro-onnx==0.6.1", "soundfile"]


def tts_dir() -> Path:
    return state_dir() / "tts"


def kokoro_python():
    py = tts_dir() / ".venv" / "bin" / "python"
    ok = py.exists() and all((tts_dir() / f).is_file() for f in KOKORO_FILES)
    return py if ok else None


def cmd_tts(args):
    sub = args[0] if args else "status"
    d = tts_dir()
    if sub == "status":
        py = kokoro_python()
        print(json.dumps({"kokoro": bool(py), "dir": str(d),
                          "missing": [f for f in KOKORO_FILES if not (d / f).is_file()]
                          + ([] if (d / ".venv/bin/python").exists() else [".venv"])}))
        return
    if sub != "setup":
        die("usage: mother tts setup [--from DIR] | mother tts status")
    d.mkdir(parents=True, exist_ok=True)
    src = _opt(args, "--from")
    for f, url in KOKORO_FILES.items():
        if (d / f).is_file():
            continue
        if src and (Path(os.path.expanduser(src)) / f).is_file():
            shutil.copyfile(Path(os.path.expanduser(src)) / f, d / f)
            print(f"copied {f}")
            continue
        print(f"downloading {f} (~{'170' if f.endswith('onnx') else '28'} MB) …", flush=True)
        r = subprocess.run(["curl", "-fL", "--retry", "2", "-o", str(d / (f + ".part")), url])
        if r.returncode:
            die(f"download failed: {url}")
        os.replace(d / (f + ".part"), d / f)
    venv = d / ".venv"
    if not (venv / "bin/python").exists():
        uv = shutil.which("uv")
        r = (subprocess.run([uv, "venv", "-q", "--python", "3.12", str(venv)]) if uv
             else subprocess.run([sys.executable, "-m", "venv", str(venv)]))
        if r.returncode:
            die("could not create the TTS virtualenv (install uv, or Python 3.10+)")
    py = str(venv / "bin/python")
    uv = shutil.which("uv")
    r = (subprocess.run([uv, "pip", "install", "-q", "--python", py, *KOKORO_PKGS]) if uv
         else subprocess.run([py, "-m", "pip", "install", "-q", *KOKORO_PKGS]))
    if r.returncode:
        die("installing kokoro-onnx failed")
    print(json.dumps({"kokoro": bool(kokoro_python()), "dir": str(d)}))


def render_kokoro(text_file: Path, out: Path, voice: str, speed: float):
    """(ok, error). WAV from Kokoro, then AAC with the system's afconvert (or ffmpeg)."""
    py = kokoro_python()
    if not py:
        return False, "Kokoro isn't installed (mother tts setup)"
    wav = out.with_suffix(".wav")
    r = subprocess.run([str(py), str(PLUGIN_ROOT / "lib" / "tts_kokoro.py"), str(tts_dir()), voice, str(speed),
                        str(text_file), str(wav)], capture_output=True, text=True)
    if r.returncode or not wav.exists():
        return False, "kokoro: " + ((r.stderr or "").strip().splitlines() or ["failed"])[-1][:200]
    conv = shutil.which("afconvert")
    cmd = ([conv, "-f", "m4af", "-d", "aac", str(wav), str(out)] if conv else
           [shutil.which("ffmpeg") or "ffmpeg", "-y", "-loglevel", "error", "-i", str(wav), "-c:a", "aac", str(out)])
    r = subprocess.run(cmd, capture_output=True, text=True)
    wav.unlink(missing_ok=True)
    if r.returncode or not out.exists():
        return False, "converting to m4a failed: " + (r.stderr or "").strip()[:200]
    return True, None


def cmd_speak(args):
    """Text to an .m4a with macOS `say`. Local only: nothing is sent anywhere; the routine shares the file."""
    ws = workspace()
    src = _opt(args, "--in")
    text = (Path(src).read_text() if src else sys.stdin.read()).strip()
    if not text:
        die("speak: empty script")
    cfg = load_config(ws)
    audio = ((cfg.get("routines") or {}).get("brief") or {}).get("audio")
    audio = audio if isinstance(audio, dict) else {}
    hebrew = bool(HEBREW_RE.search(text))
    voice = _opt(args, "--voice") or (audio.get("voice_he") if hebrew else audio.get("voice")) or (
        "Carmit" if hebrew else "Samantha")
    rate = _opt(args, "--rate") or audio.get("rate")
    name = re.sub(r"[^A-Za-z0-9._-]", "-", _opt(args, "--name") or "brief-" + _dt.date.today().isoformat())
    out_dir = ws / ".mother" / "audio"
    out_dir.mkdir(parents=True, exist_ok=True)
    out = out_dir / (name + ".m4a")
    script = out_dir / (name + ".txt")
    script.write_text(text + "\n")
    engine, note = "say", None
    # Kokoro (neural, local) for English when configured; Hebrew and any Kokoro failure fall back to `say`.
    if (_opt(args, "--engine") or audio.get("engine")) == "kokoro" and not _opt(args, "--voice"):
        if hebrew:
            note = "kokoro has no Hebrew; used say"
        else:
            kvoice = audio.get("kokoro_voice") or "af_heart"
            ok, err = render_kokoro(script, out, kvoice, (int(rate) / 175) if rate else 1.0)
            if ok:
                engine, voice = "kokoro", kvoice
            else:
                note = err + "; used say"
    if engine == "say":
        say = os.environ.get("MOTHER_SAY_BIN") or shutil.which("say")
        if not say:
            die("speak: macOS `say` not found — the spoken brief needs a Mac")
        cmd = [say, "-v", str(voice), "-o", str(out), "--file-format=m4af", "--data-format=aac", "-f", str(script)]
        if rate:
            cmd[1:1] = ["-r", str(int(rate))]
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode or not out.exists() or out.stat().st_size == 0:
            die(f"speak: say failed ({(r.stderr or '').strip() or r.returncode}) — is voice '{voice}' installed? "
                "List voices with `say -v '?'`")
    olds = sorted(out_dir.glob("*.m4a"), key=lambda f: f.stat().st_mtime)
    for f in olds[:-AUDIO_KEEP]:
        f.unlink()
        f.with_suffix(".txt").unlink(missing_ok=True)
    # A synced folder gets the file to the phone with no upload and no tokens: audio.save_to, else iCloud
    # Drive's Mother folder when iCloud Drive is on.
    shared = None
    icloud = Path.home() / "Library/Mobile Documents/com~apple~CloudDocs"
    dest = Path(os.path.expanduser(audio["save_to"])) if audio.get("save_to") else (
        icloud / "Mother" if icloud.is_dir() else None)
    if dest is not None:
        try:
            dest.mkdir(parents=True, exist_ok=True)
            shared = dest / out.name
            shutil.copyfile(out, shared)
        except OSError as e:
            print(f"speak: couldn't copy to {dest}: {e}", file=sys.stderr)
            shared = None
    words = len(text.split())
    print(json.dumps({"path": str(out), "shared_path": str(shared) if shared else None, "engine": engine,
                      "note": note, "bytes": out.stat().st_size, "voice": voice, "words": words,
                      "approx_seconds": round(words / ((int(rate) if rate else 175) / 60))}))

