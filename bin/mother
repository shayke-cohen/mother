# ---------------------------------------------------------------- memory index

MEMORY_TITLE_MAX, MEMORY_HOOK_MAX = 80, 100


def _one_line(text: str) -> str:
    """Text as one plain line: control and format characters dropped, whitespace runs collapsed."""
    import unicodedata
    out = []
    for ch in str(text or ""):
        cat = unicodedata.category(ch)
        if ch in "\t\n\r\x0b\x0c\x85  ":
            out.append(" ")
        elif cat in ("Cc", "Cf", "Co", "Cs", "Cn"):
            continue
        else:
            out.append(ch)
    return re.sub(r"\s+", " ", "".join(out)).strip()


def _frontmatter(path: Path) -> dict:
    lines = path.read_text(errors="replace").splitlines()
    if not lines or lines[0].strip() != "---":
        return {}
    found = {}
    for ln in lines[1:]:
        if ln.strip() == "---":
            break
        m = re.match(r"^(name|description):\s*(.*)$", ln)
        if m:
            found[m.group(1)] = m.group(2).strip().strip("\"'")
    return found


def memory_index(ws: Path, target: str, title=None, hook=None):
    """(changed, line) after adding one index line for memory/<file>.md to memory/MEMORY.md; raises ValueError."""
    mem = (ws / "memory").resolve()
    cand = Path(target).expanduser()
    if not cand.is_absolute():
        cand = (Path.cwd() / cand) if (Path.cwd() / cand).exists() else (ws / cand) if (ws / cand).exists() \
            else mem / cand
    f = cand.resolve()
    if f.parent != mem or f.suffix != ".md" or f.name.lower() == "memory.md" or not f.is_file():
        raise ValueError("%s is not a memory file (an existing memory/<name>.md other than MEMORY.md)" % target)
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*\.md", f.name):
        raise ValueError("%s: a memory file name is letters, digits, '.', '_' and '-' only" % f.name)
    idx = mem / "MEMORY.md"
    if idx.exists() and re.search(r"\]\(%s\)" % re.escape(f.name), idx.read_text()):
        return False, None  # already indexed: nothing to check or write
    fm = _frontmatter(f)
    t = _one_line(title if title is not None else fm.get("name") or f.stem).replace("[", "(").replace("]", ")")
    h = re.sub(r"[\[\]()]", "", _one_line(hook if hook is not None else fm.get("description") or "")).strip()
    if not t or not h:
        raise ValueError("needs a title and a hook (--title/--hook, or name/description in the file's frontmatter)")
    t, h = t[:MEMORY_TITLE_MAX], h[:MEMORY_HOOK_MAX]
    line = "- [%s](%s) — %s" % (t, f.name, h)
    lock = ws / ".mother" / "memory.lock"
    lock.parent.mkdir(parents=True, exist_ok=True)
    import fcntl
    with open(lock, "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        if idx.exists():
            cur = idx.read_text()
        else:
            tpl = TEMPLATE / "memory" / "MEMORY.md"
            cur = tpl.read_text() if tpl.exists() else "# Memory index\n"
        if re.search(r"\]\(%s\)" % re.escape(f.name), cur):
            return False, line
        new = cur + ("" if cur.endswith("\n") or not cur else "\n") + line + "\n"
        tmp = idx.with_name(".MEMORY.md.%d.tmp" % os.getpid())
        tmp.write_text(new)
        os.replace(tmp, idx)
    return True, line


def memory_check(ws: Path) -> dict:
    """Index drift: memory files with no index line, and index lines that link a missing file."""
    mem = ws / "memory"
    idx = mem / "MEMORY.md"
    text = re.sub(r"`[^`\n]*`", "", idx.read_text()) if idx.exists() else ""  # not the examples in code spans
    linked = set(re.findall(r"\]\(([^()\s]+\.md)\)", text))
    files = sorted(f.name for f in mem.glob("*.md") if f.name != "MEMORY.md") if mem.is_dir() else []
    return {"unindexed": [f for f in files if f not in linked],
            "missing": sorted(x for x in linked if not (mem / x).is_file())}


def cmd_memory(args):
    usage = "usage: mother memory index <memory-file> [--title T] [--hook H] | check"
    if args == ["check"]:
        print(json.dumps(memory_check(workspace())))
        return
    if args[:1] != ["index"] or len(args) < 2:
        print(usage, file=sys.stderr)
        sys.exit(2)
    rest, opts, pos = args[1:], {}, []
    i = 0
    while i < len(rest):
        if rest[i] in ("--title", "--hook"):
            if i + 1 >= len(rest):
                print(usage, file=sys.stderr)
                sys.exit(2)
            opts[rest[i][2:]] = rest[i + 1]
            i += 2
        else:
            pos.append(rest[i])
            i += 1
    if len(pos) != 1:
        print(usage, file=sys.stderr)
        sys.exit(2)
    try:
        changed, line = memory_index(workspace(), pos[0], opts.get("title"), opts.get("hook"))
    except ValueError as e:
        die(str(e))
    print(json.dumps({"ok": True, "changed": changed, "line": line}, ensure_ascii=False))


